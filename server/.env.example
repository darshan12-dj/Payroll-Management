# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/payroll_management
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/payroll_management
MONGO_URI=mongodb://127.0.0.1:27017/payroll_management

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=1d
JWT_RESET_SECRET=replace_this_with_a_different_long_random_secret
JWT_RESET_EXPIRES_IN=15m

# Frontend origin allowed for CORS
CLIENT_URL=http://localhost:5173

# Default company info used to seed Settings
COMPANY_NAME=Northbridge Technologies Inc.
COMPANY_EMAIL=hr@northbridge-tech.com
COMPANY_PHONE=+1 (555) 010-2938
COMPANY_ADDRESS=500 Market Street, Suite 900, San Francisco, CA 94105
